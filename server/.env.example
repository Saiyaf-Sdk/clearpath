# Copy this file to .env and fill in the values
PORT=5000

# MongoDB Atlas connection string (or local: mongodb://127.0.0.1:27017/clearpath)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clearpath

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (used for CORS and the QR code on certificates)
CLIENT_URL=http://localhost:5173

# Optional: email notifications (leave blank to just log emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ClearPath <no-reply@clearpath.local>"
