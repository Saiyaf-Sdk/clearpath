# Copy this file to .env and fill in the values (never commit .env)
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string – the database name (clearpath) goes after ".net/"
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clearpath?retryWrites=true&w=majority

# Long random secret for signing login tokens (at least 24 characters in production)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Address of the web app (CORS, links in emails and the certificate QR code).
# Local development: http://localhost:5173
# One-service deployment (API serves the app): leave empty – the request's own address is used.
CLIENT_URL=http://localhost:5173

# Dates in charts and reports are grouped in this time zone
APP_TIMEZONE=Asia/Colombo

# Demo only: show registration codes and password-reset links on screen when no email is configured.
# (Always on in local development without SMTP; keep "false" for a real deployment.)
DEMO_MODE=false

# Optional: email (leave SMTP_HOST empty to print emails in the server console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ClearPath <no-reply@clearpath.local>"
