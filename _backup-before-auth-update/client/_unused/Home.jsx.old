import { Link, Navigate } from 'react-router-dom';
import { motion } from 'framer-motion';
import { ArrowRight, BadgeCheck, BookOpen, CircleCheck, FileUp, QrCode, Send, ShieldCheck, Sparkles, Users } from 'lucide-react';
import { homeFor, useAuth } from '../context/AuthContext';
import { item, stagger } from '../components/Page';

const steps = [
  [Send, 'Submit one request', 'Apply online instead of carrying a paper form to every office.'],
  [Users, 'Departments review', 'Library, Hostel, Finance, Labs, Sports and Student Affairs clear you in parallel.'],
  [FileUp, 'Settle dues online', 'See exactly what you owe and upload your payment receipt.'],
  [QrCode, 'Get your certificate', 'Download a PDF certificate with a QR code anyone can verify.'],
];

const floatAnim = (delay) => ({
  animate: { y: [0, -10, 0] },
  transition: { duration: 5, repeat: Infinity, ease: 'easeInOut', delay },
});

export default function Home() {
  const { user } = useAuth();
  if (user) return <Navigate to={homeFor(user.role)} replace />;

  return (
    <div>
      <section className="hero">
        <motion.div variants={stagger} initial="hidden" animate="show">
          <motion.div variants={item} className="hero-badge"><Sparkles size={14} /> Paperless university clearance</motion.div>
          <motion.h1 variants={item}>
            Get cleared in <span className="grad-text">days, not weeks.</span>
          </motion.h1>
          <motion.p variants={item} className="lead">
            ClearPath replaces the paper no-dues form with one online request, live status from every department,
            and a verifiable digital certificate.
          </motion.p>
          <motion.div variants={item} className="row-gap">
            <Link to="/register" className="btn btn-primary btn-lg">Start my clearance <ArrowRight size={18} /></Link>
            <Link to="/verify" className="btn btn-ghost btn-lg"><ShieldCheck size={18} /> Verify a certificate</Link>
          </motion.div>
        </motion.div>

        {/* Floating preview cards */}
        <div className="hero-visual" aria-hidden="true">
          <motion.div className="float-card glass" style={{ top: 10, left: 20, width: 300 }} initial={{ opacity: 0, y: 30 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}>
            <motion.div {...floatAnim(0)}>
              <div className="row-gap" style={{ justifyContent: 'space-between' }}>
                <strong>Clearance progress</strong>
                <span className="badge badge-in-progress">In progress</span>
              </div>
              <div className="progress" style={{ margin: '14px 0 8px' }}>
                <motion.div className="progress-bar" initial={{ width: 0 }} animate={{ width: '67%' }} transition={{ delay: 0.6, duration: 1.2 }} />
              </div>
              <small className="muted">4 of 6 departments cleared</small>
            </motion.div>
          </motion.div>

          <motion.div className="float-card glass" style={{ top: 150, right: 0, width: 260 }} initial={{ opacity: 0, y: 30 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.35 }}>
            <motion.div {...floatAnim(1.2)} className="row-gap">
              <span className="stat-icon" style={{ background: 'linear-gradient(135deg,#10b981,#34d399)', width: 40, height: 40 }}><BookOpen size={18} /></span>
              <div>
                <strong>Library</strong>
                <div><span className="badge badge-cleared"><CircleCheck size={12} /> Cleared</span></div>
              </div>
            </motion.div>
          </motion.div>

          <motion.div className="float-card glass" style={{ top: 260, left: 60, width: 280 }} initial={{ opacity: 0, y: 30 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.5 }}>
            <motion.div {...floatAnim(2.4)} className="row-gap">
              <span className="stat-icon" style={{ background: 'var(--grad)', width: 40, height: 40 }}><BadgeCheck size={18} /></span>
              <div>
                <strong>Certificate issued</strong>
                <div className="muted small">CP-2026-8F3A21C9 · QR verified</div>
              </div>
            </motion.div>
          </motion.div>
        </div>
      </section>

      <motion.section className="steps" variants={stagger} initial="hidden" whileInView="show" viewport={{ once: true, amount: 0.3 }}>
        {steps.map(([Icon, title, text], i) => (
          <motion.div className="step glass" key={title} variants={item} whileHover={{ y: -6 }}>
            <div className="step-icon"><Icon size={20} /></div>
            <small className="muted">Step {i + 1}</small>
            <h3>{title}</h3>
            <p>{text}</p>
          </motion.div>
        ))}
      </motion.section>
    </div>
  );
}
